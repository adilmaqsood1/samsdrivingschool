# Copy to .env on the server (chmod 600, never commit). Values live on the host only.
# Source of truth for every variable: samsdriving/settings.py.

# Core — SECRET_KEY is required in production (DEBUG off).
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DJANGO_DEBUG=False

# MySQL (cPanel -> MySQL Databases). NAME/USER have sane defaults; PASSWORD is required.
DB_NAME=samsdriving_sams
DB_USER=samsdriving_id_rsa
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Outbound mail (cPanel -> Email Accounts: info@samsdriving.ca)
EMAIL_HOST=mail.samsdriving.ca
EMAIL_PORT=465
EMAIL_HOST_USER=info@samsdriving.ca
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=info@samsdriving.ca
ENROLLMENT_NOTIFICATION_EMAIL=info@samsdriving.ca

# Square (payment processing)
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_VERSION=2022-08-17

# Google Calendar OAuth (instructor lesson sync)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar

# Google Analytics 4 + Google Ads (templates render nothing when these are blank)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_PURCHASE_LABEL=
GOOGLE_ADS_LEAD_LABEL=
ANALYTICS_DEBUG=False
ANALYTICS_CURRENCY=CAD

# SMS webhook (optional — leave blank to disable)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Public site URL (used for absolute URLs in emails/redirects)
SITE_URL=https://samsdriving.ca