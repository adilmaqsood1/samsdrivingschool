# Copy to .env on the server (never commit .env). Values are set on the host only.

# Core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# MySQL (cPanel -> MySQL Databases)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Outbound mail (cPanel -> Email Accounts: info@samsdriving.ca)
EMAIL_HOST=mail.samsdriving.ca
EMAIL_PORT=465
EMAIL_HOST_USER=info@samsdriving.ca
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=info@samsdriving.ca
ENROLLMENT_NOTIFICATION_EMAIL=info@samsdriving.ca

# Public phone number shown in transactional emails.
# SCHOOL_PHONE is E.164 (used in tel: links); SCHOOL_PHONE_DISPLAY is what
# humans read in the email body. Change both when the number rotates.
SCHOOL_PHONE=+164****1708
SCHOOL_PHONE_DISPLAY=+1 (647) 889-1708

# Spam defense (crm/antispam.py)
ANTISPAM_ENABLED=True
# Leave the Turnstile keys blank to run honeypot + timing + rate-limit only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ANTISPAM_TRUST_XFF=False

# Square (unchanged)
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Google Calendar OAuth (unchanged)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

SITE_URL=https://samsdriving.ca
